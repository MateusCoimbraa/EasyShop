<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EasyShop.Models"
             x:Class="EasyShop.Views.CustomersPage"
             Title="Clientes (SQL)">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <VerticalStackLayout Spacing="8">
            <Entry Placeholder="Nome completo" Text="{Binding Name}" />
            <Entry Placeholder="E-mail" Keyboard="Email" Text="{Binding Email}" />
            <Button Text="Salvar cliente" Command="{Binding AddCommand}" />
            <Label Text="{Binding Message}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Customers}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Customer">
                    <VerticalStackLayout Padding="0,6">
                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                        <Label Text="{Binding Email}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>